# ==============================================================================
# NAKSHA-AI Environment Configuration
# ==============================================================================
# NOTE: The application works 100% OUT OF THE BOX WITH ZERO API KEYS!
# All default map layers (CartoDB, ESRI World Imagery), CORS benchmarks,
# and GIS engines use free and open-source public endpoints.
# The keys below are purely OPTIONAL for production scaling or custom providers.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 1. OPTIONAL: Survey of India (SOI) Live CORS Network
# Used for live RTCM 3.2 NRTK streaming from government reference stations.
# Portal: https://cors.surveyofindia.gov.in/
# ------------------------------------------------------------------------------
SOI_CORS_USERNAME=
SOI_CORS_PASSWORD=
SOI_CORS_CASTER_URL=ntrip.surveyofindia.gov.in
SOI_CORS_PORT=2101

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Commercial Map Tile Providers
# Used if you want custom Vector tiles instead of default CartoDB/ESRI tiles.
# MapTiler: https://cloud.maptiler.com/ (Free tier: 100,000 tiles/month)
# Mapbox:   https://account.mapbox.com/ (Free tier: 50,000 loads/month)
# ------------------------------------------------------------------------------
VITE_MAPTILER_API_KEY=
VITE_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 3. OPTIONAL: Google Maps Platform (Satellite & Geocoding)
# Used if switching base satellite tiles to Google Maps Satellite.
# Portal: https://console.cloud.google.com/google/maps-apis/
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 4. OPTIONAL: Bhuvan / ISRO Geospatial Portal
# Used for official Indian LISS-IV 5.8m satellite imagery WMS layers.
# Portal: https://bhuvan.nrsc.gov.in/
# ------------------------------------------------------------------------------
BHUVAN_API_TOKEN=

# ------------------------------------------------------------------------------
# 5. OPTIONAL: Gemini AI / LLM Cadastral Report Generation
# Used for automated legal dispute summary report generation.
# Portal: https://aistudio.google.com/ (Free Tier)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=